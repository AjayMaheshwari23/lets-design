    {
      "id": "pCPXxVdL1HVTqHsoz-hwI",
      "type": "text",
      "x": 377.33203125,
      "y": 241.62109375,
      "width": 800,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 629856891,
      "version": 1405,
      "versionNonce": 1824959605,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790919305789,
      "created": 1790911975907,
      "link": null,
      "locked": false,
      "text": "Fr's \n• User should be able to signup / login via phone number (OTP) into an account \n• User should be able to create group with a name and add members to it via \n  their phone number (if not exist then invite option)\n• Add expense in a group with amount, description and split criteria (ex. equal  \n  split, % based split, with specific people etc)\n• All the expenses in a group should be visible in chronological order with meta    \n  info ( labels, date, image etc )\n• option to settle up all the owed amount catergorised by person and record a \n  payment \n• Option to invite people via link to a group\n• Additional features like simplify group debts\n\n\nNFr's \n• balance changing operation should prefer consistency over availability \n• expense creation and settlements should be durable \n\nConstraints \n• Unique constaint on phone number for account creation\n• Total Amount of a group should sum to ZERO",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fr's \n• User should be able to signup / login via phone number (OTP) into an account \n• User should be able to create group with a name and add members to it via \n  their phone number (if not exist then invite option)\n• Add expense in a group with amount, description and split criteria (ex. equal  \n  split, % based split, with specific people etc)\n• All the expenses in a group should be visible in chronological order with meta              \n  info ( labels, date, image etc )\n• option to settle up all the owed amount catergorised by person and record a \n  payment \n• Option to invite people via link to a group\n• Additional features like simplify group debts\n\n\nNFr's \n• balance changing operation should prefer consistency over availability \n• expense creation and settlements should be durable \n\nConstraints \n• Unique constaint on phone number for account creation\n• Total Amount of a group should sum to ZERO",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
